{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goblin Yapper",
  "version": "0.1.0",
  "identifier": "com.goblinyapper.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Goblin Yapper",
        "width": 1300,
        "height": 840,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "category": "Utility",
    "shortDescription": "Twitch team sorter + goblin TTS overlay",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/goblin-yapper-server"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": { "language": "pt-BR" }
    }
  }
}
